PORT=4000
APP_PORT=80

# Prefer a single connection URL in production (Neon / Supabase / Vercel Postgres)
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Or set discrete fields (used by local Docker compose)
POSTGRES_DB=crablearn
POSTGRES_USER=crablearn
POSTGRES_PASSWORD=change-me
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=crablearn
PGPASSWORD=change-me
PGDATABASE=crablearn
# PGSSLMODE=require

# Frontend (empty = same-origin API when served by Express/Vercel)
# VITE_API_BASE_URL=
