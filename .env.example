PORT=4000
APP_PORT=80

# Prefer a single connection URL in production (Supabase / Neon)
# Supabase → Project Settings → Database → Connection string (URI)
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
DATABASE_URL=

POSTGRES_DB=crablearn
POSTGRES_USER=crablearn
POSTGRES_PASSWORD=change-me
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=crablearn
PGPASSWORD=change-me
PGDATABASE=crablearn
# PGSSLMODE=require

# Supabase client (browser). Vite requires VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
