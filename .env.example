PORT=4000
APP_PORT=80

# Prefer a single connection URL in production (Supabase / Neon)
# Supabase → Project Settings → Database → Connection string (URI)
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
DATABASE_URL=

POSTGRES_DB=crablearn
POSTGRES_USER=crablearn
POSTGRES_PASSWORD=change-me
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=crablearn
PGPASSWORD=change-me
PGDATABASE=crablearn
# PGSSLMODE=require

# Supabase client (browser). Vite requires VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Novu unified notifications (configure email, SMS, and WhatsApp steps in Novu workflows)
NOVU_API_KEY=
NOVU_SECRET_KEY=
NOVU_API_URL=https://api.novu.co
NOVU_PASSWORD_WORKFLOW=password-otp
NOVU_PASSWORD_UPDATED_WORKFLOW=password-updated
NOVU_MEETING_WORKFLOW=meeting-scheduled

# Novu Inbox browser application identifier
VITE_NOVU_APPLICATION_IDENTIFIER=
# Set these only when the Novu workspace uses a non-default region.
VITE_NOVU_BACKEND_URL=
VITE_NOVU_SOCKET_URL=
